<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_panel_steampunk"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <CheckBox
        android:id="@+id/rowCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <ImageView
        android:id="@+id/rowPlayIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/cd_menu_play_file"
        android:scaleType="centerInside"
        android:src="@drawable/ic_action_play" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowFileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/steam_parchment"
            android:textSize="14sp"
            tools:text="Titlu video" />

        <TextView
            android:id="@+id/rowFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/steam_parchment_dim"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Oliver Sjostrom"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/rowDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/steam_parchment_dim"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="3:45"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRowMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mai multe acțiuni"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
