<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_panel_steampunk"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <CheckBox
        android:id="@+id/rowCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp">

        <ImageView
            android:id="@+id/rowThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1A1510"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_action_play" />

        <TextView
            android:id="@+id/rowDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:background="@drawable/bg_duration_badge"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:ignore="RtlSymmetry"
            tools:text="3:45"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowFileTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="5"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/steam_parchment"
            android:textSize="13sp"
            tools:text="Titlu video lung care trebuie afisat complet pe mai multe randuri.mp4" />

        <TextView
            android:id="@+id/rowFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/steam_parchment_dim"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Oliver Sjostrom"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRowMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Mai multe acțiuni"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
